# Buggy client configuration exhibiting Instance 12:
# OpenSSH parses first-match-wins.
# Placing ProxyJump server3 under 'Host *' at the top shadows and overrides
# any subsequent host-specific ProxyJump directives (e.g. Host server2).

Host *
    ProxyJump server3
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    User deploy

Host server1
    HostName 10.0.0.1
    Port 22

Host server3
    HostName 10.0.0.3
    Port 22
    ProxyJump server1

Host server2
    HostName 10.0.0.2
    Port 22
    ProxyJump server1
