# Clean/fixed client configuration:
# ProxyJump server3 is removed from the top-level 'Host *' stanza.
# Host-specific stanzas (server3 -> server1, server2 -> server1) evaluate cleanly.

Host *
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    User deploy

Host server1
    HostName 10.0.0.1
    Port 22

Host server3
    HostName 10.0.0.3
    Port 22
    ProxyJump server1

Host server2
    HostName 10.0.0.2
    Port 22
    ProxyJump server1
