# =====================================================================
# Enterprise Bastion Mesh Client Configuration (Fixed Instance 12)
# Specific host stanzas are unshadowed (Port 22, User deploy, and
# loop-free multi-hop ProxyJump: wc-client -> server1 -> server3 -> server2).
# =====================================================================

Host *
    IdentityFile /home/deploy/.ssh/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ConnectTimeout 4
    LogLevel ERROR
    ServerAliveInterval 15
    ServerAliveCountMax 3

Host bastion-gateway
    HostName 10.202.1.3
    User deploy
    Port 22

Host !server1 !server3 server*
    ControlMaster no

Host *.compute.internal
    ForwardAgent no

Host server1
    HostName server1
    User deploy
    Port 22

Host server3
    HostName server3
    User deploy
    Port 22
    ProxyJump server1

Host server2
    HostName server2
    User deploy
    Port 22
    ProxyJump server3
